rules_version = '2';

// Healthcare Digital Twin: security rules, version 5 (adds medical history).
// Roles live in users/{uid}.role and are "patient", "doctor" or "admin".
// These rules run on Google's servers and cannot be bypassed from the browser.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // The patient themselves, a doctor the patient shares with, or an admin.
    function canReadPatient(patientId) {
      return signedIn()
        && (request.auth.uid == patientId
            || isAdmin()
            || request.auth.uid in get(/databases/$(database)/documents/patients/$(patientId)).data.assignedDoctorIds);
    }

    // Account roles.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // A new account can give itself the "patient" or "doctor" role, never "admin".
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role in ['patient', 'doctor'];
      // Names and roles are changed only by the server (the profile and admin APIs).
      allow update, delete: if false;
    }

    // Patient records. The document ID is the patient's account UID.
    match /patients/{patientId} {
      allow read: if signedIn()
        && (request.auth.uid == patientId
            || request.auth.uid in resource.data.assignedDoctorIds
            || isAdmin());
      // A patient creates their own record with no doctors assigned.
      allow create: if signedIn()
        && request.auth.uid == patientId
        && request.resource.data.assignedDoctorIds.size() == 0;
      // Profiles and the list of doctors are changed only by the server
      // (the profile and care-team APIs), which validates every change.
      allow update, delete: if false;

      // Health data: readings, twin state, baseline, alerts and daily summaries.
      // Readable by the patient, assigned doctors and admins.
      // Not writable from any browser. Only the server (ingest API) writes here.
      match /readings/{readingId} {
        allow read: if canReadPatient(patientId);
        allow write: if false;
      }
      match /twin/{docId} {
        allow read: if canReadPatient(patientId);
        allow write: if false;
      }
      match /baseline/{docId} {
        allow read: if canReadPatient(patientId);
        allow write: if false;
      }
      match /alerts/{alertId} {
        allow read: if canReadPatient(patientId);
        allow write: if false;
      }
      match /daily/{day} {
        allow read: if canReadPatient(patientId);
        allow write: if false;
      }
      // Medical history: conditions, medications, surgeries, allergies, events.
      match /history/{recordId} {
        allow read: if canReadPatient(patientId);
        allow write: if false;
      }
    }

    // Everything else is denied.
  }
}
